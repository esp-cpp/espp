CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# QEMU's ESP32 machine: 4 MB flash, PSRAM emulated with -m 4M (idf.py qemu's
# default) - the engine's pools, lwIP and a fragmented sample want more than
# the 320 KB of internal RAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# the OpenCores MAC QEMU emulates, instead of the chip's own EMAC
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=n
CONFIG_ETH_USE_OPENETH=y

# the engine: embedded profile, fragmentation + RPC compiled in
CONFIG_RTPS_LIMITS_PROFILE_EMBEDDED=y
CONFIG_RTPS_ENABLE_FRAGMENTATION=y
CONFIG_RTPS_ENABLE_RPC=y

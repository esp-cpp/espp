# The harness (run_qemu_interop.sh): QEMU on a tap device with no DHCP server,
# the host side at 192.168.100.1.
CONFIG_RTPS_QEMU_STATIC_IP=y
CONFIG_RTPS_QEMU_IP="192.168.100.2"
CONFIG_RTPS_QEMU_NETMASK="255.255.255.0"
CONFIG_RTPS_QEMU_GATEWAY="192.168.100.1"

# The many-participants case puts twelve unrelated ROS 2 participants on the
# domain before the one the device needs; the embedded profile's pool holds
# ten. Raise it through the menuconfig knob, which is what an application on a
# busy domain has to do - and what the case then proves works.
CONFIG_RTPS_LIMIT_SPDP_MAX_NUMBER_FOUND_PARTICIPANTS=24
# ... and the pool is only as useful as the builtin discovery endpoints'
# proxy pools: each of the four SEDP endpoints holds one proxy per remote
# participant, from the per-endpoint proxy knobs (6 in the embedded profile).
# A peer whose proxies do not fit is forgotten and retried on its next
# announcement. Raised to 20, deliberately below the participant pool, so the
# overflow case exercises that retry as well as the full-pool one.
CONFIG_RTPS_LIMIT_NUM_WRITER_PROXIES_PER_READER=20
CONFIG_RTPS_LIMIT_NUM_READER_PROXIES_PER_WRITER=20

# Every ros2 CLI invocation the harness makes is a participant that announces
# a 20 s lease (FastDDS) and then exits; left to the announced lease, the dead
# ones pile up in the pool across cases. Cap what the device honours (the
# knob exists for exactly this) so a gone peer is forgotten in 8 s.
CONFIG_RTPS_SPDP_MAX_REMOTE_LEASE_DURATION_S=8

# A ROS 2 participant carries about ten built-in endpoints (parameters,
# rosout, type description ...), so twelve of them present well over a
# hundred remote endpoints: more than the embedded profile's 50-entry
# unmatched-endpoint pools ("[MemoryPool] RESSOURCE LIMIT EXCEEDED" on the
# device; the topic the device needs still matched), and some of their type
# names are longer than the profile's 64-character cap ("Type name length 69
# exceeds maximum", those endpoints are skipped). Both are knobs; raised here.
# (a `ros2 topic pub` node also serves the six parameter services: about
# fourteen endpoints per participant, so twelve of them are near the
# embedded profile's 8-bit ceiling of 255 for these pools)
CONFIG_RTPS_LIMIT_MAX_NUM_UNMATCHED_REMOTE_WRITERS=255
CONFIG_RTPS_LIMIT_MAX_NUM_UNMATCHED_REMOTE_READERS=255
CONFIG_RTPS_LIMIT_MAX_TYPENAME_LENGTH=96
# and a `ros2 topic pub` node's parameter-service topics (rq/<node>/get_parametersRequest
# and friends) run 70-85 characters: over the profile's 64-character topic-name
# cap ("Topic name length 77 exceeds maximum allowed length 64", skipped).
CONFIG_RTPS_LIMIT_MAX_TOPICNAME_LENGTH=96

# The firmware hosts a ROS 2 action server next to its topics and service:
# five more RELIABLE writers (status, feedback, three replies) and three more
# request readers than the embedded profile's pools of five hold, and more
# endpoints per participant than its cap of ten. Raised here for the embedded
# build only - the host profiles reset these to their own (larger) defaults.
CONFIG_RTPS_LIMIT_NUM_STATEFUL_WRITERS=10
CONFIG_RTPS_LIMIT_NUM_STATEFUL_READERS=10
CONFIG_RTPS_LIMIT_NUM_WRITERS_PER_PARTICIPANT=12
CONFIG_RTPS_LIMIT_NUM_READERS_PER_PARTICIPANT=12

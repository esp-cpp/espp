CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Set the FreeRTOS rate to 1ms (1000Hz)
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Common ESP-related
#
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

#
# Ethernet (ESP32-Ethernet-Kit A V1.2 — IP101GRI RMII PHY)
#
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_USE_IP101=y

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

#
# lwIP: a FastDDS or CycloneDDS peer sends a sample under 64 KB as ONE UDP
# datagram, IP-fragmented on the wire, and ESP-IDF's lwIP has IP reassembly
# OFF by default: without this a sample bigger than one MTU never reaches the
# engine (found by the QEMU interop matrix, components/rtps/interop/qemu).
# Buffers for a 64 KB datagram, and socket mailboxes deep enough for the
# burst of fragments (or DATA_FRAG datagrams) that arrive back to back.
#
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP_REASS_MAX_PBUFS=48
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

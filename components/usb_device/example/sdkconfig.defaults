# The USB vendor / WebUSB, CDC and MSC functions use the native USB-OTG
# peripheral, available on the ESP32-S3 (also S2 / P4) -- NOT the classic ESP32.
# Pin the target so a bare `idf.py build` does not fall back to esp32.
CONFIG_IDF_TARGET="esp32s3"

# Common ESP-related
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console on UART0 (secondary on USB-Serial-JTAG): on the S3, USB-Serial-JTAG
# shares the native USB PHY with USB-OTG, which TinyUSB takes over for the
# interfaces this example presents.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# TinyUSB class drivers: vendor (WebUSB) + CDC (Web Serial) for the framed
# protocol, MSC for the USB drive; HID count only so usb_device's HID code
# paths compile (no HID interface is instantiated here).
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

# MSC over a flash partition: 4096-byte wear-levelling sectors with a 4096-byte
# MSC buffer, so each host write is one flash erase + write (see
# UsbDevice::MscFunction); the FAT volume label the host shows needs
# CONFIG_FATFS_USE_LABEL.
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_LABEL=y

# Task statistics for MonitorService (GET_TASKS / TASKS stream): the FreeRTOS
# trace facility + run-time stats, and the core id per task.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Standard USB services (system / monitor / OTA / core dump): the OTA+coredump
# (+ storage) partition layout (partitions.csv), core dumps to flash, OTA
# rollback, and the FreeRTOS run-time statistics the task monitor reads.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LilyGo T-Deck overrides (applied on top of sdkconfig.defaults).
# ESP32-S3, 16MB flash, octal PSRAM.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Octal PSRAM (frame buffers are allocated in SPIRAM).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Display / LVGL.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=16

# Touch is read from the interrupt task; the 4KB default overflows on the error path.
CONFIG_TDECK_INTERRUPT_STACK_SIZE=8192
